<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
    
<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.funki.controller.DeckEditorController"
            styleClass="main-root">
    <top>
        <HBox spacing="10"
              alignment="CENTER_LEFT"
              styleClass="top-bar">
            <Button text="+ Add Card"
                    onAction="#addCard"/>
            <Button text="Remove"
                    onAction="#removeSelectedCard"/>
            <Button text="Save"
                    onAction="#saveDeck"/>
        </HBox>
    </top>
    <center>
        <TableView fx:id="cardsTable"
                   editable="true"
                   BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="frontColumn"
                             text="Front"
                             prefWidth="300"/>
                <TableColumn fx:id="backColumn"
                             text="Back"
                             prefWidth="300"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
