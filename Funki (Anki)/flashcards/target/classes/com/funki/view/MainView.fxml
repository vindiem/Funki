<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.funki.controller.MainController"
            styleClass="main-root">
    <top>
        <MenuBar useSystemMenuBar="true">
            <Menu text="File">
                <MenuItem text="Open Deck..." onAction="#chooseDeck"/>
                <SeparatorMenuItem/>
                <MenuItem text="Study" onAction="#showStudyView"/>
                <MenuItem text="Deck Editor" onAction="#showDeckEditor"/>
                <SeparatorMenuItem/>
                <MenuItem text="Exit" onAction="#exitApplication"/>
            </Menu>
            <Menu text="View">
                <MenuItem text="Grey Theme" onAction="#setGreyTheme"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#about"/>
            </Menu>
        </MenuBar>
    </top>
    <center>
        <StackPane fx:id="contentPane"/>
    </center>
</BorderPane>
